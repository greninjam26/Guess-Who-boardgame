<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guesswho</groupId>
        <artifactId>guess-who-boardgame</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>server</artifactId>
    <name>Guess Who Server</name>
    <description>The HTTP API and the database behind it.</description>

    <dependencies>
        <dependency>
            <groupId>com.guesswho</groupId>
            <artifactId>game-core</artifactId>
        </dependency>
        <!-- Compile scope rather than runtime, deliberately. The deployed server
             needs the driver either way, and PostgresMigrationTest builds a
             PGSimpleDataSource directly — runtime scope would leave that test
             uncompilable and the fix would look like an afterthought. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Flyway 10 split each database into its own module. Without this one
             Flyway starts and then refuses PostgreSQL at the moment it matters,
             which is on the deployed server rather than here. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <!-- Password hashing only, for now. The filter chain and login come
             with the next piece; this one just needs BCrypt. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Test scope only, and only for the live online-game test: it plays a
             whole game with the real desktop client against a real server, which
             is the one thing neither module can check on its own. Nothing here
             reaches the installer, which packages runtime dependencies. -->
        <dependency>
            <groupId>com.guesswho</groupId>
            <artifactId>desktop-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.guesswho.GuessWhoServerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
