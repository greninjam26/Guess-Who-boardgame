<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.guesswho</groupId>
    <artifactId>guess-who-boardgame</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Guess Who Board Game</name>
    <description>A Java Swing adaptation of the Guess Who board game.</description>

    <modules>
        <module>game-core</module>
        <module>desktop-client</module>
        <module>server</module>
    </modules>

    <properties>
        <!-- Flyway warns on every start that a newer H2 has not been verified
             with it. Pinning to the version it has checked removes a warning
             that would otherwise be permanent noise on a deployed server, and
             nothing here uses anything H2 added since. -->
        <h2.version>2.3.232</h2.version>
        <java.version>17</java.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.guesswho</groupId>
                <artifactId>game-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Nothing here mocks anything, but Spring Boot's test support loads
             Mockito whenever a @SpringBootTest runs, and Mockito then attaches
             its own agent to the running JVM. Declaring it explicitly is what
             gives the surefire configuration below a path to point at; leaving
             it transitive would mean every module resolving a property that
             only some of them have. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Sets a property per dependency holding its jar's
                             path, which is how the agent below is located
                             without hardcoding a version or a repository
                             layout. -->
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Swing components are constructed in tests, so no display is available.

                         Mockito is loaded as an agent rather than left to attach
                         itself. Self-attachment already warns on this JDK and is
                         stated to stop working on a later one, so a suite that
                         self-attaches today is one that fails to start after an
                         upgrade — and it prints four lines of warning on every
                         run in the meantime. -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Djava.awt.headless=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
